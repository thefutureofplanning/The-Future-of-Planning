# Public site URL (no trailing slash). Used for canonical URLs, sitemap, RSS and OG images.
NEXT_PUBLIC_SITE_URL=https://thefutureofplanning.com

# Calendly scheduling link, e.g. https://calendly.com/jennasmith/intro
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/30min

# Public contact address used by the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=thefutureofplanning@gmail.com

# Newsletter provider (optional). Without a key, /api/subscribe returns a clear
# "not configured" message instead of silently dropping signups.
BUTTONDOWN_API_KEY=
