# Public site URL (no trailing slash). Used for canonical URLs, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=https://thefutureofplanning.com

# Scheduling link for the booking page, e.g. https://cal.com/jenna-smith/30min
NEXT_PUBLIC_SCHEDULING_URL=https://cal.com/jenna-smith/30min

# Public contact address used by the contact page.
NEXT_PUBLIC_CONTACT_EMAIL=thefutureofplanning@gmail.com

# Beehiiv newsletter provider (optional). Without these, /api/subscribe returns
# a clear "not configured" message instead of silently dropping signups.
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
